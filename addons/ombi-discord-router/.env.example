# MediaOps Discord Router example configuration
# Historical addon/container naming is retained for compatibility.
# Copy to .env for local use. Never commit a populated .env file.

# IANA timezone used by the container for log timestamps.
TZ=America/Toronto

# Full Discord Forum webhook URL.
# SECRET: the URL contains a Discord credential. Do not publish or log it.
MEDIA_REQUESTS_WEBHOOK=

# Display name used by the webhook when posting request updates.
MEDIA_REQUESTS_WEBHOOK_NAME=Media Request Herald

# Optional Discord bot token used for dynamic Forum tag updates.
# SECRET: keep masked and grant only the permissions required for the target Forum.
DISCORD_BOT_TOKEN=

# Discord Forum tag ID applied to newly submitted media requests.
MEDIA_TAG_REQUESTED=

# Discord Forum tag ID used when a request is approved or processing.
MEDIA_TAG_PROCESSING=

# Discord Forum tag ID used when the request provider reports availability.
MEDIA_TAG_AVAILABLE=

# Discord Forum tag ID used when processing/acquisition fails.
MEDIA_TAG_FAILED=

# Discord Forum tag ID used when a request is denied or rejected.
MEDIA_TAG_DENIED=

# Discord Forum media-type tag IDs.
MEDIA_TAG_MOVIE=
MEDIA_TAG_SERIES=

# Optional diagnostic tag used by Ombi/Seerr webhook test posts.
MEDIA_TAG_TEST=

# Persistent index location inside the container. Leave at /data.
ROUTER_DATA_DIR=/data

# Host-side persistent data directory used by compose.example.yaml.
ROUTER_DATA_HOST_DIR=./data

# Existing user-defined Docker network shared by the request provider and router.
# The compatibility container name remains ombi-discord-router.
MEDIAOPS_NETWORK=mediaops-backend
