# Ombi Discord Router example configuration
# Copy to .env for local use. Never commit a real webhook URL/token.

TZ=America/Toronto

# Full Discord webhook URL for the target Forum channel.
# Treat this value as a secret.
MEDIA_REQUESTS_WEBHOOK=

# Display name used by the webhook when posting request updates.
MEDIA_REQUESTS_WEBHOOK_NAME=Media Request Herald

# Discord Forum status tag IDs.
MEDIA_TAG_REQUESTED=
MEDIA_TAG_PROCESSING=
MEDIA_TAG_AVAILABLE=
MEDIA_TAG_FAILED=
MEDIA_TAG_DENIED=

# Discord Forum media-type tag IDs.
MEDIA_TAG_MOVIE=
MEDIA_TAG_SERIES=

# Optional persistent index location inside the container.
ROUTER_DATA_DIR=/data

# Optional Docker network name used by compose.example.yaml.
MEDIAOPS_NETWORK=mediaops-backend
