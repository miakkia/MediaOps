# MediaOps Discord Router example configuration
# Historical addon/container naming is retained for compatibility.
# Copy to .env for local use. Never commit a populated .env file.

TZ=America/Toronto

# Full Discord Forum webhook URL. SECRET: do not publish or log it.
MEDIA_REQUESTS_WEBHOOK=
MEDIA_REQUESTS_WEBHOOK_NAME=Media Request Herald

# Optional Discord bot token for dynamic Forum tag updates. SECRET.
DISCORD_BOT_TOKEN=

MEDIA_TAG_REQUESTED=
MEDIA_TAG_PROCESSING=
MEDIA_TAG_AVAILABLE=
MEDIA_TAG_FAILED=
MEDIA_TAG_DENIED=
MEDIA_TAG_MOVIE=
MEDIA_TAG_SERIES=
MEDIA_TAG_TEST=

ROUTER_DATA_DIR=/data
ROUTER_DATA_HOST_DIR=./data
MEDIAOPS_NETWORK=mediaops-backend

# Provider webhook security. Keep port 8080 private even when authentication is enabled.
# off      = backward-compatible; no token required.
# optional = validate the token when supplied, but allow providers not yet migrated.
# required = fail closed unless the correct token is supplied in ROUTER_AUTH_HEADER.
ROUTER_AUTH_HEADER=X-MediaOps-Webhook-Token
ROUTER_MAX_BODY_BYTES=262144

# Seerr supports custom webhook headers. Configure the same secret in Seerr and
# then set SEERR_WEBHOOK_AUTH=required. Generate a long random secret; never commit it.
SEERR_WEBHOOK_AUTH=off
SEERR_WEBHOOK_TOKEN=

# Ombi deployments should remain private-network-only unless their webhook path
# is fronted by a trusted proxy/integration capable of adding the auth header.
# Do not put the secret in a query string because access logs may record URLs.
OMBI_WEBHOOK_AUTH=off
OMBI_WEBHOOK_TOKEN=
