# Ombi Discord Router example configuration
# Copy to .env for local use. Never commit a populated .env file.

# IANA timezone used by the container for log timestamps.
TZ=America/Toronto

# Full Discord Forum webhook URL.
# SECRET: the URL contains a Discord credential. Do not publish or log it.
MEDIA_REQUESTS_WEBHOOK=

# Display name used by the webhook when posting request updates.
MEDIA_REQUESTS_WEBHOOK_NAME=Media Request Herald

# Discord Forum tag ID applied to newly submitted media requests that are
# waiting to be processed.
MEDIA_TAG_REQUESTED=

# Discord Forum tag ID used when a media request has been approved or is
# currently being processed.
MEDIA_TAG_PROCESSING=

# Discord Forum tag ID used when the requested media is available on the
# configured media server. Terminal request state.
MEDIA_TAG_AVAILABLE=

# Discord Forum tag ID used when processing or acquiring the requested media
# has failed. Terminal request state.
MEDIA_TAG_FAILED=

# Discord Forum tag ID used when a media request has been denied or rejected.
# Terminal request state.
MEDIA_TAG_DENIED=

# Discord Forum tag ID identifying a request as a movie. This tag is preserved
# throughout the request lifecycle.
MEDIA_TAG_MOVIE=

# Discord Forum tag ID identifying a request as a TV series. This tag is
# preserved throughout the request lifecycle.
MEDIA_TAG_SERIES=

# Persistent index location inside the container. Leave at /data for the
# packaged Docker/Unraid deployment.
ROUTER_DATA_DIR=/data

# Host-side persistent data directory used by compose.example.yaml.
ROUTER_DATA_HOST_DIR=./data

# Existing user-defined Docker network shared by Ombi and the router.
# Using a named network lets Ombi reach http://ombi-discord-router:8080/ombi
# without depending on a changing container IP address.
MEDIAOPS_NETWORK=mediaops-backend
