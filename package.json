{
  "name": "mediaops",
  "version": "1.0.0",
  "description": "MediaOps is an open-source platform that brings together Discord, media servers, request systems, watch parties, notifications, automation and community management into one modern solution for homelab enthusiasts and media server administrators.",
  "type": "module",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "deploy-commands": "node dist/deploy-commands.js",
    "deploy-commands:dev": "tsx src/deploy-commands.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miakkia/MediaOps.git"
  },
  "keywords": [
    "discord",
    "emby",
    "media-server",
    "watch-party",
    "self-hosted",
    "homelab"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/miakkia/MediaOps/issues"
  },
  "homepage": "https://github.com/miakkia/MediaOps#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
