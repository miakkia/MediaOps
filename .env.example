# MediaOps example configuration
# Copy to .env for local development only. Never commit real secrets.

MEDIA_PROVIDER=emby

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

EMBY_URL=http://192.168.1.100:8096
EMBY_API_KEY=

# Optional request provider. Supported values: none, ombi.
# Leave disabled until Ombi URL and API key are configured.
REQUEST_PROVIDER=none
OMBI_URL=http://192.168.1.100:3579
OMBI_API_KEY=
# true: MediaOps approves newly created Ombi requests automatically.
# false: requests remain pending for an Ombi administrator to approve.
OMBI_AUTO_APPROVE=false

# Public URL used for Discord links.
WATCHPARTY_URL=https://watch.example.com
# Optional internal/LAN URL used by MediaOps to call the Watch Party API.
# Falls back to WATCHPARTY_URL when omitted.
WATCHPARTY_INTERNAL_URL=http://192.168.1.100:5000
# Dedicated non-admin Emby account used to create and host parties.
WATCHPARTY_EMBY_USER=
WATCHPARTY_EMBY_PASSWORD=
# Number of days to keep completed/cancelled Watch Party history before cleanup.
WATCHPARTY_RETENTION_DAYS=30

# Default language used for automated messages that are not tied
# to a Discord interaction. Supported values: en, fr.
MEDIAOPS_LOCALE=en
# Default timezone used when Watch Party scheduling input has no explicit offset.
# Use an IANA timezone name such as America/Toronto.
MEDIAOPS_TIMEZONE=America/Toronto

# Persistent application-owned runtime data.
# Docker/Unraid deployments should normally keep this as /data.
MEDIAOPS_DATA_DIR=/data
