# MediaOps example configuration
# Copy to .env for local development only. Never commit real secrets.
#
# V1 deployment model: self-hosted / single-tenant.
# Create and own the Discord application/bot used by this MediaOps instance.
# Provider configuration below is global to this container; do not reuse one
# v1 instance as a universal bot across unrelated guilds with different backends.
# See docs/DISCORD_BOT_SETUP.md.

# Optional public-facing branding used by MediaOps panels and messages.
MEDIAOPS_BOT_NAME=MediaOps Bot
MEDIAOPS_SERVER_NAME=My Media Server
# true: Discord Watch Party join URLs are never emitted. Link buttons are shown
# disabled for safe public/demo screenshots and Community bot demonstrations.
MEDIAOPS_DEMO_MODE=false

# Media provider. Supported values: emby, jellyfin.
MEDIA_PROVIDER=emby

# Credentials/IDs for YOUR Discord application/bot and intended guild.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Configure only the selected media provider.
EMBY_URL=http://192.168.1.100:8096
EMBY_API_KEY=
JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_API_KEY=

# Optional request provider. Supported values: none, ombi, seerr.
REQUEST_PROVIDER=none

# Configure only the selected request provider.
OMBI_URL=http://192.168.1.100:3579
OMBI_API_KEY=
SEERR_URL=http://192.168.1.100:5055
SEERR_API_KEY=

# Request approval is owned by the selected provider.
# Configure Ombi Auto Approve roles or Seerr AUTO_APPROVE permissions in the
# provider itself. MediaOps submits requests but does not force approval.

# Optional Discord Forum synchronization for Ombi request notifications.
# The companion Ombi Discord Router creates/posts the Forum thread; MediaOps
# accepts lifecycle updates only from the configured webhook ID in this Forum,
# replaces the request-status tag, preserves Movie/Series, and closes/locks
# terminal requests. Configure the complete set below or leave it disabled.
MEDIA_REQUESTS_FORUM_ID=
# Discord webhook ID only. Do NOT put the secret webhook URL/token here.
MEDIA_REQUESTS_WEBHOOK_ID=
MEDIA_TAG_REQUESTED=
MEDIA_TAG_PROCESSING=
MEDIA_TAG_AVAILABLE=
MEDIA_TAG_FAILED=
MEDIA_TAG_DENIED=
MEDIA_TAG_MOVIE=
MEDIA_TAG_SERIES=

# Public URL used for Discord links when MEDIAOPS_DEMO_MODE=false.
WATCHPARTY_URL=https://watch.example.com
# Optional internal/LAN URL used by MediaOps to call the Watch Party API.
# Falls back to WATCHPARTY_URL when omitted.
WATCHPARTY_INTERNAL_URL=http://192.168.1.100:5000
# Dedicated non-admin Emby account used to create and host parties.
WATCHPARTY_EMBY_USER=
WATCHPARTY_EMBY_PASSWORD=
WATCHPARTY_RETENTION_DAYS=30

# Default language used for automated messages that are not tied
# to a Discord interaction. Supported values: en, fr.
MEDIAOPS_LOCALE=en
# IANA timezone used when scheduling input has no explicit offset.
MEDIAOPS_TIMEZONE=America/Toronto

# Persistent application-owned runtime data.
# Docker/Unraid deployments should normally keep this as /data.
MEDIAOPS_DATA_DIR=/data
